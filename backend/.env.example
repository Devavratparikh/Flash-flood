# Backend HTTP port
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/himvaah

# JWT signing secret for the lightweight demo auth
JWT_SECRET=dev-only-change-me

# Redis for the BullMQ ingestion queue. If unreachable, the backend falls
# back to recomputing risk synchronously in-process.
REDIS_URL=redis://localhost:6379
USE_QUEUE=true

# Risk scoring engine:
#   index      hand-built hydrological risk index (default) - transparent,
#              smooth in every input, no Python needed.
#   ml-layer1  50/50 blend of the index and the Python Layer-1 XGBoost model;
#              falls back to the index alone if the service is unreachable.
RISK_ENGINE=index
ML_LAYER1_URL=http://localhost:5001

# Comma-separated list of allowed CORS origins (frontend dev server)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:8080
